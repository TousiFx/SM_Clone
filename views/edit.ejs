<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit</title>
    <style>
      /* Reset and base font */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
      }

      /* Center the layout on the page */
      body {
        background-color: #f3f4f6;
        color: #1f2937;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 20px;
      }

      /* Heading */
      h1 {
        font-size: 1.75rem;
        color: #111827;
        margin-bottom: 0.75rem;
      }

      /* Sender and receiver info badge */
      p {
        background-color: #e5e7eb;
        color: #4b5563;
        padding: 0.6rem 1.2rem;
        border-radius: 20px;
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
        text-align: center;
      }

      p i {
        font-style: normal;
        font-weight: 600;
        color: #2563eb;
      }

      /* Card container for the form */
      form {
        background-color: #ffffff;
        width: 100%;
        max-width: 450px;
        padding: 2rem;
        border-radius: 12px;
        box-shadow:
          0 4px 6px -1px rgba(0, 0, 0, 0.1),
          0 2px 4px -1px rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      /* Message input area */
      textarea {
        width: 100%;
        min-height: 140px;
        padding: 0.85rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 1rem;
        line-height: 1.5;
        color: #1f2937;
        resize: vertical;
        transition:
          border-color 0.2s,
          box-shadow 0.2s;
      }

      textarea:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
      }

      /* Save button */
      button {
        background-color: #2563eb;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition:
          background-color 0.2s,
          transform 0.1s;
      }

      button:hover {
        background-color: #1d4ed8;
      }

      button:active {
        transform: scale(0.98);
      }
    </style>
  </head>

  <body>
    <h1>Edit user</h1>
    <p>This user is send by <i><%=user.from%></i> to <i><%=user.to%></i></p>
    <form method="POST" action="/clone/<%= user._id %>?_method=PUT">
      <textarea name="msg"><%=user.msg%></textarea>
      <button>Save edit</button>
    </form>
  </body>
</html>
